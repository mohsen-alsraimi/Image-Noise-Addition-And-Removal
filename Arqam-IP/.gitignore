# Python virtual environment (recreate with: pip install -r requirements.txt)
.venv/

# Python cache files
__pycache__/
*.py[cod]

# Generated outputs - recreated by running the code.
# Keep the folder structure (.gitkeep files) but ignore everything else.
results/**
!results/**/
!results/**/.gitkeep

# The synthetic test image is regenerated by demos/demo_image_loading.py
data/input/synthetic_test_image.png

# Temporary, editor and operating-system files
*.tmp
*.log
~$*
.vscode/
Thumbs.db
desktop.ini
.DS_Store
